{
  "name": "telegrabun",
  "version": "0.1.0",
  "description": "A type-safe, Bun-first Telegram Bot API library",
  "keywords": [
    "bot",
    "bun",
    "telegram",
    "telegram-bot",
    "telegram-bot-api",
    "typescript"
  ],
  "homepage": "https://github.com/NikitaBautin/telegrabun#readme",
  "bugs": {
    "url": "https://github.com/NikitaBautin/telegrabun/issues"
  },
  "license": "MIT",
  "author": "Nikita Bautin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikitaBautin/telegrabun.git"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "generate": "bun run scripts/telegram-schema/generate.ts",
    "update:telegram-schema": "bun run scripts/telegram-schema/update-snapshot.ts",
    "verify:telegram-schema": "bun run scripts/telegram-schema/verify-snapshot.ts",
    "check:generated": "bun run scripts/telegram-schema/check-generated.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "pack:check": "bun run scripts/check-package.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@types/bun": "1.4.0",
    "husky": "9.1.7",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
